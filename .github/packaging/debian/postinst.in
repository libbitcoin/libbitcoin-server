#!/bin/sh
set -e

directory=/usr/lib/libbitcoin-server

supports()
{
    for feature in "$@"; do
        echo "${features}" | grep -qx "${feature}" || return 1
    done
}

if [ "$1" = "configure" ]; then
    features="$("${directory}/selector")"

    if supports @OPTIMIZED_REQUIRES@; then
        variant=@OPTIMIZED@
    elif supports @BASELINE_REQUIRES@; then
        variant=@BASELINE@
    else
        echo "libbitcoin-server: this processor supports no packaged variant of bs." >&2
        exit 1
    fi

    ln -sf "${directory}/${variant}" /usr/bin/bs
    echo "libbitcoin-server: installed ${variant} as /usr/bin/bs."

    # Create the service account and store directory, and load the service
    # unit (not enabled).
    if command -v systemd-sysusers > /dev/null; then
        systemd-sysusers /usr/lib/sysusers.d/libbitcoin-server.conf
    fi

    if command -v systemd-tmpfiles > /dev/null; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/libbitcoin-server.conf || true
    fi

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi

    # A 'bs -d true' unit conflicts with the packaged service (only one runs).
    if [ -f /etc/systemd/system/bs.service ]; then
        echo "libbitcoin-server: found /etc/systemd/system/bs.service (from 'bs -d true')." >&2
        echo "libbitcoin-server: it conflicts with libbitcoin-server.service, run 'bs -d false' to remove it." >&2
    fi
fi
