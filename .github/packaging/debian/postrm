#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # The service account and /var/lib/libbitcoin-server are retained.
        if [ "$1" = "purge" ]; then
            rm -f /etc/systemd/system/multi-user.target.wants/libbitcoin-server.service
        fi

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac
