#
#  Command-line completion for bs.
#
_bs()
{
    local current="${COMP_WORDS[COMP_CWORD]}"

    local options="
        --accept -a
        --backup -b
        --buckets -k
        --collisions -l
        --config -c
        --daemon -d
        --flags -f
        --hardware -w
        --help -h
        --information -i
        --newstore -n
        --restore -r
        --settings -s
        --user -u
        --version -v
    "

    # Only options are completed; other words fall back to the default.
    if [[ "$current" == -* ]]; then
        COMPREPLY=( `compgen -W "$options" -- "$current"` )
    fi
}
complete -o default -F _bs bs
