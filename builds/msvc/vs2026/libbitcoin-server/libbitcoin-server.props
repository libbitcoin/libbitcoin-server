<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>libbitcoin-server Settings</_PropertySheetDisplayName>
  </PropertyGroup>

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Condition="Exists('$(MSBuildThisFileDirectory)libbitcoin-server.xml')" Include="$(MSBuildThisFileDirectory)libbitcoin-server.xml" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(RepoRoot)build\include\;$(RepoRoot)include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'DynamicLibrary'">BCS_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'StaticLibrary'">BCS_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-self-tests)' == 'true'">WITH_SELF_TESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(SolutionDir)libbitcoin-system.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-database.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-network.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-node.import.props" />
  </ImportGroup>

  <PropertyGroup>
    <Linkage-libbitcoin-system>$(DefaultLinkage)</Linkage-libbitcoin-system>
    <Linkage-libbitcoin-database>$(DefaultLinkage)</Linkage-libbitcoin-database>
    <Linkage-libbitcoin-network>$(DefaultLinkage)</Linkage-libbitcoin-network>
    <Linkage-libbitcoin-node>$(DefaultLinkage)</Linkage-libbitcoin-node>
  </PropertyGroup>

  <PropertyGroup>
    <Option-self-tests Condition="'$(Option-self-tests)' == ''">false</Option-self-tests>
  </PropertyGroup>

  <Target Name="OptionInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Option-self-tests : $(Option-self-tests)" Importance="high"/>
  </Target>

  <Target Name="LinkageInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Linkage-libbitcoin-system   : $(Linkage-libbitcoin-system)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-database : $(Linkage-libbitcoin-database)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-network  : $(Linkage-libbitcoin-network)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-node     : $(Linkage-libbitcoin-node)" Importance="high"/>
  </Target>

</Project>
