<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>bs Settings</_PropertySheetDisplayName>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Condition="Exists('$(MSBuildThisFileDirectory)bs.xml')" Include="$(MSBuildThisFileDirectory)bs.xml" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions Condition="'$(Option-web)' == 'true'">WITH_WEB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(RepoRoot)build\include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(SolutionDir)libbitcoin-system.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-database.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-network.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-node.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-server.import.props" />
  </ImportGroup>

  <PropertyGroup>
    <Linkage-libbitcoin-system>$(DefaultLinkage)</Linkage-libbitcoin-system>
    <Linkage-libbitcoin-database>$(DefaultLinkage)</Linkage-libbitcoin-database>
    <Linkage-libbitcoin-network>$(DefaultLinkage)</Linkage-libbitcoin-network>
    <Linkage-libbitcoin-node>$(DefaultLinkage)</Linkage-libbitcoin-node>
    <Linkage-libbitcoin-server>$(DefaultLinkage)</Linkage-libbitcoin-server>
  </PropertyGroup>

  <PropertyGroup>
    <Option-web Condition="'$(Option-web)' == ''">true</Option-web>
  </PropertyGroup>

  <Target Name="OptionInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Option-web : $(Option-web)" Importance="high"/>
  </Target>

  <Target Name="LinkageInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Linkage-libbitcoin-system   : $(Linkage-libbitcoin-system)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-database : $(Linkage-libbitcoin-database)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-network  : $(Linkage-libbitcoin-network)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-node     : $(Linkage-libbitcoin-node)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-server   : $(Linkage-libbitcoin-server)" Importance="high"/>
  </Target>

</Project>
